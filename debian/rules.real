SHELL  := sh -e
comma:=,

export DH_OPTIONS

#
# Targets
#
binary_generic:
	dh_testdir
	dh_testroot
	dh_prep
	dh_install
	dh_bugfiles
	dh_installchangelogs
	dh_installdocs -XTODO
	dh_installdebconf
	dh_lintian
	dh_link
	dh_compress
	dh_fixperms
	dh_installdeb
	if command -v dh_movetousr >/dev/null; then dh_movetousr; fi
	dh_gencontrol
	dh_md5sums
	dh_builddeb

binary_meta: binary_generic
