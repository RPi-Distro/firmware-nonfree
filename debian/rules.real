SHELL  := sh -e
comma:=,

export DH_OPTIONS

#
# Targets
#
binary_generic:
	dh_testdir
	dh_testroot
	dh_prep
	@for i in $(subst [comma],$(comma),$(FILES)); do \
	  s="$${i%:*}"; \
	  d=/usr/lib/firmware/"$${i#*:}"; \
	  echo install -m644 -D "$$s" debian/$(PACKAGE_NAME)"$$d"; \
	  install -m644 -D "$$s" debian/$(PACKAGE_NAME)"$$d"; \
	done
	@for i in $(subst [comma],$(comma),$(LINKS)); do \
	  link=debian/$(PACKAGE_NAME)/usr/lib/firmware/"$${i%:*}"; \
	  target="$${i#*:}"; \
	  install -d "$${link%/*}"; \
	  echo ln -s "$$target" "$$link"; \
	  ln -s "$$target" "$$link"; \
	done
ifneq ($(FILES),)
	dh_installdirs /usr/share/metainfo
	dh_install debian/org.debian.$(subst -,_,$(PACKAGE_NAME)).metainfo.xml /usr/share/metainfo
endif
	dh_bugfiles
	dh_installchangelogs
	dh_installdocs -XTODO
	dh_installdebconf
	dh_lintian
	dh_link
	dh_compress
	dh_fixperms
	dh_installdeb
	dh_gencontrol
	dh_md5sums
	dh_builddeb

binary_meta: binary_generic
